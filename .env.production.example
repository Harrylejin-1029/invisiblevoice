# Production Environment Variables
# Copy this file to .env.production and update the values

# Application
NODE_ENV=production
CLIENT_URL=https://your-domain.com
VITE_API_URL=https://your-domain.com/api
VITE_AI_URL=https://your-domain.com/api/ai

# Database
MONGO_ROOT_USERNAME=your_mongo_user
MONGO_ROOT_PASSWORD=your_secure_mongo_password
MONGODB_URI=mongodb://your_mongo_user:your_secure_mongo_password@mongodb:27017/sign2viet?authSource=admin

# Redis
REDIS_URL=redis://redis:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRE=7d

# AI Service
USE_MOCK=false
LOG_LEVEL=info

# Security
# Add any other security-related environment variables here
